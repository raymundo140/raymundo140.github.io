---
import SocialIcons from './SocialIcons.astro'
---

<footer class='footer footer-center bg-base-100 text-base-content px-4 py-10 gap-3'>
	<aside class='flex flex-col items-center gap-1'>
		<p class='font-bold'>Roberto Raymundo Gómez Vargas</p>
		<p class='text-sm text-base-content/70'>Robotics & AI Engineer</p>
		<p class='text-sm text-base-content/60 max-w-md'>
			Building autonomous robotic systems across perception, navigation, manipulation, AI, and embedded systems.
		</p>
	</aside>
	<div class='flex gap-4 max-w-xs'>
		<SocialIcons />
	</div>
	<aside>
		<p class='text-xs text-base-content/50'>
			© {new Date().getFullYear()} Roberto Raymundo Gómez Vargas. Built with Astro and GitHub Pages.
		</p>
	</aside>
</footer>
