---
import Layout from "../layouts/Layout.astro";
import { template } from "@/settings";

const base = template.base;
const pdfPath = `${import.meta.env.BASE_URL}cv/Raymundo_CV.pdf`;
---

<Layout
  title="CV | Raymundo Gómez Vargas"
  description="A one-page overview of my robotics research, engineering experience, education, projects, and technical skills."
>
  <section class="space-y-4">
    <h1 class="text-3xl font-black">Curriculum Vitae</h1>
    <p class="text-base-content/70">
      A one-page overview of my robotics research, engineering experience, education, projects,
      and technical skills.
    </p>

    <div class="flex gap-3 flex-wrap">
      <a class="btn btn-primary" href={pdfPath} download>
        Download CV (PDF)
      </a>

      <a class="btn btn-outline" href={pdfPath} target="_blank" rel="noopener">
        Open Full Screen
      </a>
    </div>

    <p class="text-sm opacity-70">Last updated: September 2026</p>

    <div class="w-full rounded-xl overflow-hidden border border-base-200 hidden sm:block">
      <iframe
        title="Raymundo CV"
        src={`${pdfPath}#view=FitH`}
        class="w-full"
        style="height: 130vh;"
      ></iframe>
    </div>

    <p class="text-sm text-base-content/70 pt-4 border-t border-base-200">
      For deeper technical work, explore the <a href={base + '/projects'} class="link">Projects</a> and <a href={base + '/research'} class="link">Research</a> pages.
    </p>
  </section>
</Layout>
