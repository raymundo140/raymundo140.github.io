---
import Layout from '../layouts/Layout.astro'
import ResearchCard from '@/components/ui/ResearchCard.astro'
import { research, template } from '@/settings'
const base = template.base
---

<Layout title="Research | Raymundo Gómez Vargas" description="Research in autonomous mapping, dynamic-environment perception, mobile manipulation, and intelligent robotic systems.">
  <div class='max-w-4xl mx-auto py-12'>
    <div class='mb-12 border-b pb-8'>
      <h1 class='text-4xl font-bold mb-3'>Research & Invited Talks</h1>
      <p class='text-base-content/70 text-lg'>
        Research in autonomous mapping, dynamic-environment perception, mobile manipulation, and intelligent robotic systems.
      </p>
    </div>
    <div class='flex flex-col gap-4'>
      {research.map(item => (
        <ResearchCard item={item} base={base} />
      ))}
    </div>
  </div>
</Layout>
